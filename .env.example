# Copy this file to .env.local and fill in what you use. Everything is
# optional: without any of these the site runs with the feed, local saves,
# and the rule-based tagger.

# Accounts (Supabase). Both values are public by design; row-level security
# in the database is what protects the data. See supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Neural recommender and tagger (the FastAPI service in recommender/).
NEXT_PUBLIC_RECOMMENDER_URL=
RECOMMENDER_URL=

# Public address of the deployed site, for absolute links in the sitemap and
# the share preview. On Vercel it is derived automatically when unset.
NEXT_PUBLIC_SITE_URL=
